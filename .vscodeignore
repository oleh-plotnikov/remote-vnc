# Source — only the bundled output ships. Match by extension, not by name: a
# sync-conflict copy ("webview 2.ts") once slipped past a per-file list and
# shipped source in the package.
src/**
media/**/*.ts
node_modules/**
# A "nosync" symlink keeps dependencies out of cloud sync on macOS, and vsce
# records the resolved path, so the pattern above never sees them.
node_modules.nosync/**

# Sync-conflict duplicates ("style 2.css", "icon 3.png") of any type.
**/* [0-9].*

# Tooling / config
.vscode/**
.devcontainer/**
.github/**
esbuild.js
tsconfig.json
**/*.map
**/.DS_Store

# Repo meta. Being git-ignored is not enough — vsce reads this file, not
# .gitignore, so scratch directories have to be named here too or their
# contents ship inside the package.
.gitignore
.git/**
.claude/**
.superpowers/**
*.code-workspace

# Not needed in the package
test/**
docs/**
AGENTS.md
image.png
*.vsix
